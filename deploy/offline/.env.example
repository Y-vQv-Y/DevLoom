# Copy to /opt/devloom/.env and replace every value marked with CHANGE_ME.
# Pin all images to an immutable release tag or digest before deployment.
INSTALL_DIR=/opt/devloom
REMOTE_IP=devloom.intra.example
NGINX_PORT=80
SUBNET_PREFIX=10.100.50

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=devloom
POSTGRES_USER=devloom
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=CHANGE_ME_redis_password

CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
CLICKHOUSE_DB=devloom
CLICKHOUSE_USER=devloom
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse_password

RUSTFS_IMAGE=rustfs/rustfs:RELEASE_TAG
RUSTFS_ACCESS_KEY=CHANGE_ME_storage_access_key
RUSTFS_SECRET_KEY=CHANGE_ME_storage_secret_key

FRONTEND_IMAGE=registry.intra.example/devloom/frontend:RELEASE_TAG
BACKEND_IMAGE=registry.intra.example/devloom/backend:RELEASE_TAG
INGRESS_IMAGE=registry.intra.example/devloom/ingress:RELEASE_TAG

# These two images are external runtime dependencies and are required for task execution.
TASKFLOW_IMAGE=registry.intra.example/devloom/taskflow:RELEASE_TAG
PREVIEW_IMAGE=registry.intra.example/devloom/preview:RELEASE_TAG

TEAM_EMAIL=admin@intra.example
TEAM_NAME=Internal Development Team
TEAM_PASSWORD=CHANGE_ME_initial_admin_password
INIT_TEAM_IMAGE=
RELAY_SECRET=CHANGE_ME_at_least_32_random_characters

WORKSPACE_ISOLATED=true
WORKSPACE_BRANCH_PREFIX=devloom
WORKSPACE_PUSH_MODE=pull_request
WORKSPACE_OPENHANDS_WORKTREE=true

# Optional values used by compose.override.yml.
PUBLIC_BASE_URL=http://devloom.intra.example
CONFIG_FILE=/opt/devloom/config/config.yaml
