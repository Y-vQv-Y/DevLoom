# Copy to deploy/package/package.env and pin every image to a version or digest.
BRAND_NAME=DevLoom
BRAND_SLUG=devloom
DEFAULT_INSTALL_DIR=/opt/devloom
TARGET_ARCH=amd64
IMAGE_PREFIX=devloom.local

# Compatible runtime images. These sources are not in this repository.
TASKFLOW_IMAGE=CHANGE_ME/taskflow:PINNED_VERSION
PREVIEW_IMAGE=CHANGE_ME/preview:PINNED_VERSION
ORCHESTRATOR_IMAGE=CHANGE_ME/orchestrator:PINNED_VERSION
DEVBOX_IMAGE=CHANGE_ME/devbox:PINNED_VERSION

# Infrastructure images included in the center bundle.
POSTGRES_IMAGE=postgres:17.4-alpine3.21
REDIS_IMAGE=redis:8.0-alpine3.21
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.3.9
RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.2

# Docker static bundle versions. A prebuilt archive may be supplied instead.
DOCKER_VERSION=29.4.3
COMPOSE_VERSION=v5.1.3
DOCKER_TGZ_SHA256=CHANGE_ME_FROM_DOCKER_RELEASE
COMPOSE_BINARY_SHA256=CHANGE_ME_FROM_COMPOSE_RELEASE
DOCKER_BUNDLE_FILE=

# Optional package inputs.
PROJECT_TEMPLATE_DIR=deploy/package/project-template
EXTENSION_PACKAGES_DIR=
OUTPUT_DIR=deploy/out
