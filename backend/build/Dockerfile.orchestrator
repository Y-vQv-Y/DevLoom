FROM --platform=$BUILDPLATFORM golang:1.25.8-alpine3.23 AS builder

WORKDIR /src
ENV CGO_ENABLED=0
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
COPY go.mod go.sum ./
ARG GOMODCACHE=/go/pkg/mod
RUN --mount=type=cache,target=${GOMODCACHE} go mod download
ARG TARGETOS TARGETARCH GOCACHE=/root/.cache/go-build
RUN --mount=type=bind,target=. \
    --mount=type=cache,target=${GOMODCACHE} \
    --mount=type=cache,target=${GOCACHE} \
    GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /out/orchestrator ./cmd/orchestrator

FROM docker:29-cli
RUN apk add --no-cache ca-certificates git tzdata
COPY --from=builder /out/orchestrator /usr/local/bin/devloom-orchestrator
RUN mkdir -p /workspaces
EXPOSE 8890
ENV TZ=Asia/Shanghai
ENTRYPOINT ["/usr/local/bin/devloom-orchestrator"]
